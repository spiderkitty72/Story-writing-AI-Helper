# Copy to .env and fill in what you use. Leave blank to disable a provider.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Models (optional overrides)
OLLAMA_MODEL=llama3.1:8b
CLAUDE_MODEL=claude-sonnet-5-5
GEMINI_MODEL=gemini-2.5-flash

# Where the app finds Ollama. The default compose file starts Ollama for you.
# To use an Ollama already running on your computer instead, set:
# OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_URL=http://ollama:11434

# Port for the web app on your computer
APP_PORT=8000

# Bind the app's port to one address. Use 127.0.0.1 when Nginx Proxy Manager
# runs on the same machine, so the app can only be reached through it.
APP_BIND=0.0.0.0

# ---- Accounts ----
# The first admin is created from these when there are no accounts yet.
# You can remove ADMIN_PASSWORD after the first start.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- Running behind a reverse proxy (Nginx Proxy Manager) over HTTPS ----
# IPs or ranges allowed to set X-Forwarded-For / X-Forwarded-Proto.
# Use the address NPM connects from, e.g. 172.16.0.0/12 for Docker networks.
FORWARDED_ALLOW_IPS=127.0.0.1
# auto = Secure cookies when the request is HTTPS. Set true when using HTTPS.
COOKIE_SECURE=auto
# Send Strict-Transport-Security over HTTPS (true/false).
HSTS=true
# Extra origins allowed to send requests (comma separated). Usually empty.
ALLOWED_ORIGINS=
# Login lockout: failures allowed per username / per IP within the window.
LOGIN_MAX_FAILS_PER_USER=5
LOGIN_MAX_FAILS_PER_IP=10
LOGIN_LOCKOUT_MINUTES=15
# Sessions end after this long without use, or this many days at most.
SESSION_IDLE_HOURS=168
SESSION_MAX_DAYS=30
